# Frontend -> Lambda/API Gateway URL (set in Amplify Console > Environment variables for production)
# Example: https://abc123.execute-api.ap-south-1.amazonaws.com/slack-notify
VITE_SLACK_API_URL=

# Backend only - set in Lambda > Configuration > Environment variables (never VITE_*)
SLACK_CONTACT_WEBHOOK_URL=
SLACK_AUDIT_WEBHOOK_URL=
